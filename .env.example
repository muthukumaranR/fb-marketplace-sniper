# Email notifications (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
NOTIFY_EMAIL=your-email@example.com

# Redis (Celery broker) — docker-compose overrides this to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Default search location
DEFAULT_LOCATION=Huntsville, AL
DEFAULT_RADIUS=20

# Deal thresholds (percentage of fair price)
GREAT_DEAL_THRESHOLD=0.60
GOOD_DEAL_THRESHOLD=0.75

# Skip the email below this relevance score (0-1), even if the price looks great
NOTIFY_MIN_RELEVANCE=0.5

# Facebook cookie storage
FB_STATE_PATH=~/.config/marketswipe/fb_state.json

# LLM API keys (for price estimation via LiteLLM) — set at least one.
# Blablador (Helmholtz/FZ Jülich) is preferred when its key is present.
# Get a key at https://sdlaml.pages.jsc.fz-juelich.de/ai/guides/blablador_api_access/
BLABLADOR_API_KEY=
BLABLADOR_URL=https://api.blablador.fz-juelich.de/v1
BLABLADOR_MODEL_ALIAS=alias-fast
BLABLADOR_MODEL_LARGE=alias-kimi-k3-1m

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Override provider auto-detection entirely (LiteLLM model string)
LLM_MODEL=

# Scan frequency (minutes)
SCAN_INTERVAL_MINUTES=30
